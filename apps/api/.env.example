# Copy to .env and fill in.

# --- Database (Neon Postgres) ---
# Get both of these from your Neon project dashboard -> Connection Details.
# DATABASE_URL: the "Pooled connection" string (hostname contains "-pooler").
#   Used by the running app for normal queries — safe for many concurrent
#   serverless/short-lived connections.
# DIRECT_URL: the "Direct connection" string (no "-pooler" in the hostname).
#   Used only by Prisma's migration commands — Neon's pooler runs in
#   transaction mode, which does not support the DDL statements migrations
#   need, so migrations must bypass the pooler.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# JWT signing secret for the auth module.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on.
PORT=4000

# --- AI provider ---
# "anthropic" uses real Claude calls for sentiment/emotion/topic/summary/chat.
# "mock" runs the full pipeline with deterministic fake outputs — useful for
# demoing or developing the frontend without burning API credits.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""

# --- YouTube ingestion ---
# Required only for the "youtube" extraction path. Get one from Google Cloud
# Console (YouTube Data API v3 must be enabled on the project).
YOUTUBE_API_KEY=""

# CORS origin for the frontend — set this to your deployed frontend URL in
# production (e.g. https://commentiq.vercel.app), not just localhost.
WEB_ORIGIN="http://localhost:3000"
